#!/bin/bash -p
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [[ ${SSH_ORIGINAL_COMMAND-} =~ ^deploy\ (sha256:[0-9a-f]{64})$ ]]; then
    exec /usr/bin/sudo -n -- /usr/local/sbin/portfolio-deploy "${BASH_REMATCH[1]}"
fi
printf '%s\n' 'Only deploy sha256:<64 lowercase hexadecimal characters> is allowed.' >&2
exit 64
