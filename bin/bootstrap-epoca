#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
[[ $EUID == 0 && $# == 1 ]] || { printf '%s\n' 'Usage: sudo bootstrap-epoca /path/to/deploy-key.pub' >&2; exit 64; }
[[ -f /opt/portfolio/state/deployment.json && -f /opt/portfolio/caddy/Caddyfile ]]
ssh-keygen -l -f "$1" >/dev/null
key=$(cat -- "$1")
[[ $key =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,3}(\ [^$'\n']*)?$ ]]
source_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
exec 9>/opt/portfolio/state/deploy.lock
flock -n 9
install -d -o root -g root -m 755 /opt/epoca /opt/portfolio/caddy/sites /usr/local/lib/portfolio
install -d -o root -g root -m 700 /opt/epoca/state /opt/epoca/state/releases
install -o root -g root -m 755 "$source_dir/bin/deploy.py" /usr/local/lib/portfolio/deploy.py
install -o root -g root -m 755 "$source_dir/bin/deploy.py" /usr/local/sbin/portfolio-deploy
install -o root -g root -m 755 "$source_dir/bin/epoca_deploy.py" /usr/local/lib/portfolio/epoca_deploy.py
install -o root -g root -m 755 "$source_dir/bin/epoca-ssh" /usr/local/sbin/epoca-ssh
install -o root -g root -m 644 "$source_dir/epoca/compose.yaml" /opt/epoca/compose.yaml
python3 - <<'PY'
import os
from pathlib import Path
import secrets
root = Path('/opt/epoca')
database = root / 'database.env'
api = root / 'api.env'
gateway = root / 'gateway.env'
if len({database.exists(), api.exists(), gateway.exists()}) != 1:
    raise SystemExit('Incomplete environment; refusing to regenerate credentials.')
if not database.exists():
    password = secrets.token_urlsafe(36)
    signing = secrets.token_urlsafe(48)
    for path, content in (
        (database, f'POSTGRES_USER=epoca\nPOSTGRES_PASSWORD={password}\nPOSTGRES_DB=epoca\n'),
        (api, f'DB_URL=jdbc:postgresql://postgres:5432/epoca\nDB_USER=epoca\nDB_PASSWORD={password}\nJWT_SECRET={signing}\n'),
        (gateway, f'DATABASE_URL=postgres://epoca:{password}@postgres:5432/epoca\nJWT_SECRET={signing}\n'),
    ):
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as output:
            output.write(content)
route = Path('/opt/portfolio/caddy/sites/epoca.caddy')
if not route.exists():
    route.write_text('')
    route.chmod(0o644)
PY
if id epoca-deploy >/dev/null 2>&1; then
    [[ $(id -Gn epoca-deploy) == epoca-deploy ]]
    [[ $(getent passwd epoca-deploy | cut -d: -f6-7) == /var/lib/epoca-deploy:/bin/sh ]]
else
    useradd --system --user-group --home-dir /var/lib/epoca-deploy --shell /bin/sh --password '*' epoca-deploy
fi
install -d -o root -g root -m 755 /var/lib/epoca-deploy /etc/ssh/authorized_keys
printf 'restrict %s\n' "$key" > /etc/ssh/authorized_keys/epoca-deploy
chmod 644 /etc/ssh/authorized_keys/epoca-deploy
printf '%s\n' 'epoca-deploy ALL=(root) NOPASSWD: /usr/local/lib/portfolio/epoca_deploy.py *' > /etc/sudoers.d/epoca-deploy
chmod 440 /etc/sudoers.d/epoca-deploy
visudo -cf /etc/sudoers.d/epoca-deploy
cat > /etc/ssh/sshd_config.d/00-epoca-deploy.conf <<'CONFIG'
Match User epoca-deploy
    AuthorizedKeysFile /etc/ssh/authorized_keys/epoca-deploy
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    DisableForwarding yes
    PermitTTY no
    PermitTunnel no
    PermitUserRC no
    ForceCommand /usr/local/sbin/epoca-ssh
Match all
CONFIG
chmod 644 /etc/ssh/sshd_config.d/00-epoca-deploy.conf
/usr/sbin/sshd -t
/usr/sbin/sshd -T -C user=epoca-deploy,host=localhost,addr=127.0.0.1 | grep -x 'forcecommand /usr/local/sbin/epoca-ssh' >/dev/null
systemctl reload ssh
python3 - <<'PY'
from pathlib import Path
import subprocess
path = Path('/opt/portfolio/caddy/Caddyfile')
before = path.read_text()
if 'import sites/*.caddy' not in before:
    path.write_text('import sites/*.caddy\n\n' + before)
    try:
        subprocess.run(['docker','exec','portfolio-caddy-1','caddy','validate','--config','/etc/caddy/Caddyfile','--adapter','caddyfile'], check=True)
        subprocess.run(['docker','exec','portfolio-caddy-1','caddy','reload','--config','/etc/caddy/Caddyfile','--adapter','caddyfile'], check=True)
    except BaseException:
        path.write_text(before)
        subprocess.run(['docker','exec','portfolio-caddy-1','caddy','reload','--config','/etc/caddy/Caddyfile','--adapter','caddyfile'], check=True)
        raise
PY
export API_BLUE_IMAGE=ghcr.io/bartkozik/epoca-backend:pending
export API_GREEN_IMAGE=$API_BLUE_IMAGE
export GATEWAY_BLUE_IMAGE=ghcr.io/bartkozik/epoca-demo-gateway:pending
export GATEWAY_GREEN_IMAGE=$GATEWAY_BLUE_IMAGE
export WEB_BLUE_IMAGE=ghcr.io/bartkozik/epoca-frontend:pending
export WEB_GREEN_IMAGE=$WEB_BLUE_IMAGE
docker compose -p epoca -f /opt/epoca/compose.yaml config --quiet
docker compose -p epoca -f /opt/epoca/compose.yaml up -d --wait --wait-timeout 90 postgres
printf '%s\n' 'EPOCA database and restricted deployment account ready.'
